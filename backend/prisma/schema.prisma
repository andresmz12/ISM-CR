generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SUPERVISOR
  AGENT
}

enum InteractionType {
  CALL
  EMAIL
  WHATSAPP
  SMS
  VISIT
  OTHER
}

enum DealStage {
  PROSPECTING
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

model User {
  id           String   @id @default(uuid())
  fullName     String
  email        String   @unique
  passwordHash String
  role         Role     @default(AGENT)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedClients Client[]           @relation("AssignedAgent")
  interactions    Interaction[]
  reassignedFrom  ClientAssignment[] @relation("ReassignedBy")
  deals           Deal[]

  @@map("users")
}

model Status {
  id        String   @id @default(uuid())
  name      String   @unique
  order     Int      @default(0)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  clients      Client[]
  interactions Interaction[]

  @@map("statuses")
}

model Client {
  id              String    @id @default(uuid())
  fullName        String
  phone           String
  phoneAlt        String?
  email           String?
  address         String?
  statusId        String
  status          Status    @relation(fields: [statusId], references: [id])
  assignedAgentId String?
  assignedAgent   User?     @relation("AssignedAgent", fields: [assignedAgentId], references: [id])
  source          String?
  tags            String[]  @default([])
  nextFollowUpAt  DateTime?
  companyId       String?
  company         Company?  @relation(fields: [companyId], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  interactions Interaction[]
  assignments  ClientAssignment[]
  auditLogs    AuditLog[]
  deals        Deal[]

  @@index([statusId])
  @@index([assignedAgentId])
  @@index([phone])
  @@index([companyId])
  @@map("clients")
}

model Interaction {
  id             String          @id @default(uuid())
  clientId       String
  client         Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId         String
  user           User            @relation(fields: [userId], references: [id])
  type           InteractionType @default(CALL)
  notes          String
  resultStatusId String?
  resultStatus   Status?         @relation(fields: [resultStatusId], references: [id])
  createdAt      DateTime        @default(now())

  @@index([clientId])
  @@index([userId])
  @@map("interactions")
}

model ClientAssignment {
  id             String   @id @default(uuid())
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  fromAgentId    String?
  toAgentId      String
  reassignedById String
  reassignedBy   User     @relation("ReassignedBy", fields: [reassignedById], references: [id])
  createdAt      DateTime @default(now())

  @@index([clientId])
  @@map("client_assignments")
}

model AuditLog {
  id        String   @id @default(uuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId    String?
  field     String
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())

  @@index([clientId])
  @@map("audit_logs")
}

model ApiKey {
  id         String    @id @default(uuid())
  name       String
  keyHash    String    @unique
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@map("api_keys")
}

model Company {
  id        String   @id @default(uuid())
  name      String
  industry  String?
  phone     String?
  website   String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clients Client[]
  deals   Deal[]

  @@index([name])
  @@map("companies")
}

model Deal {
  id                String    @id @default(uuid())
  title             String
  clientId          String?
  client            Client?   @relation(fields: [clientId], references: [id])
  companyId         String?
  company           Company?  @relation(fields: [companyId], references: [id])
  amount            Float?
  stage             DealStage @default(PROSPECTING)
  ownerId           String?
  owner             User?     @relation(fields: [ownerId], references: [id])
  expectedCloseDate DateTime?
  closedAt          DateTime?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([stage])
  @@index([ownerId])
  @@index([clientId])
  @@index([companyId])
  @@map("deals")
}
