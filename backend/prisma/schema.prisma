generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SUPERVISOR
  AGENT
}

enum InteractionType {
  CALL
  EMAIL
  WHATSAPP
  SMS
  VISIT
  OTHER
}

enum DealStage {
  PROSPECTING
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  BLOCKED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model User {
  id           String   @id @default(uuid())
  fullName     String
  email        String   @unique
  passwordHash String
  role         Role     @default(AGENT)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedClients      Client[]           @relation("AssignedAgent")
  interactions         Interaction[]
  reassignedFrom       ClientAssignment[] @relation("ReassignedBy")
  deals                Deal[]
  projectMemberships   ProjectMember[]
  assignedProjectTasks ProjectTask[]
  savedFilters         SavedFilter[]
  attachments          Attachment[]

  @@map("users")
}

model Status {
  id        String   @id @default(uuid())
  name      String   @unique
  order     Int      @default(0)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  clients      Client[]
  interactions Interaction[]

  @@map("statuses")
}

model Client {
  id                 String    @id @default(uuid())
  fullName           String
  phone              String
  phoneAlt           String?
  // Solo dígitos, para detección de duplicados independiente del formato
  // ("8888-1234" y "88881234" deben coincidir). Se mantienen desde el backend.
  phoneNormalized    String?
  phoneAltNormalized String?
  email              String?
  // Minúsculas + trim, igual que phoneNormalized: permite matchear por email sin
  // diferenciar mayúsculas/minúsculas (ej. webhook de campañas de email) con índice.
  emailNormalized    String?
  address            String?
  statusId           String
  status             Status    @relation(fields: [statusId], references: [id])
  assignedAgentId    String?
  assignedAgent      User?     @relation("AssignedAgent", fields: [assignedAgentId], references: [id])
  source             String?
  tags               String[]  @default([])
  nextFollowUpAt     DateTime?
  // Última interacción registrada (denormalizado): base de las alertas de
  // "lead sin contactar" y "cliente frío" sin joins costosos.
  lastContactedAt    DateTime?
  companyId          String?
  company            Company?  @relation(fields: [companyId], references: [id])
  // Proyecto/negocio al que pertenece este cliente (Paquetería App, DSM Consulting, etc.).
  // Opcional: los clientes existentes antes de esta columna se quedan en NULL y se
  // tratan como "visibles sin restricción de proyecto" (ver clientScope.js).
  // "Empresa" en la UI: agrupa clientes y controla acceso por equipo, además de
  // sus propios tableros de tareas/secciones. Opcional: los clientes sin projectId
  // (todo el dataset previo a esta columna) siguen visibles sin restricción de
  // proyecto (ver clientScope.js).
  projectId          String?
  project            Project?  @relation(fields: [projectId], references: [id])
  // Destinatario de la recogida más reciente (RECOGIDA-PAQ). Se sobreescribe en
  // cada webhook, igual que `address` — un cliente puede pedir varias recogidas
  // con destinatarios distintos y esto solo refleja la más reciente.
  recipientName      String?
  recipientAddress   String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  interactions Interaction[]
  assignments  ClientAssignment[]
  auditLogs    AuditLog[]
  deals        Deal[]
  attachments  Attachment[]
  listItems    ClientListItem[]

  @@index([statusId])
  @@index([assignedAgentId])
  @@index([phone])
  @@index([phoneNormalized])
  @@index([phoneAltNormalized])
  @@index([emailNormalized])
  @@index([companyId])
  @@index([lastContactedAt])
  @@index([projectId])
  @@map("clients")
}

// Listas de clientes dentro de una empresa (ej. "Tibios", "Zona Norte",
// "Importación enero") — a diferencia de `tags` (texto libre por cliente sin
// gestión centralizada), estas son entidades propias de la empresa: se pueden
// crear al importar un lote, renombrar, ver cuántos clientes tiene cada una,
// y un cliente puede estar en varias a la vez.
model ClientList {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  items ClientListItem[]

  @@unique([projectId, name])
  @@index([projectId])
  @@map("client_lists")
}

model ClientListItem {
  clientId String
  client   Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  listId   String
  list     ClientList @relation(fields: [listId], references: [id], onDelete: Cascade)
  addedAt  DateTime   @default(now())

  @@id([clientId, listId])
  @@index([listId])
  @@map("client_list_items")
}

model SavedFilter {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  filters   Json
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("saved_filters")
}

// Archivos por cliente (cotizaciones, contratos, fotos). Se guardan en la BD
// porque Railway no tiene disco persistente; el límite de tamaño lo impone
// el endpoint de subida.
model Attachment {
  id           String   @id @default(uuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  fileName     String
  mimeType     String
  size         Int
  data         Bytes
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([clientId])
  @@map("attachments")
}

model Interaction {
  id             String          @id @default(uuid())
  clientId       String
  client         Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId         String
  user           User            @relation(fields: [userId], references: [id])
  type           InteractionType @default(CALL)
  notes          String
  resultStatusId String?
  resultStatus   Status?         @relation(fields: [resultStatusId], references: [id])
  createdAt      DateTime        @default(now())

  @@index([clientId])
  @@index([userId])
  @@map("interactions")
}

model ClientAssignment {
  id             String   @id @default(uuid())
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  fromAgentId    String?
  toAgentId      String
  reassignedById String
  reassignedBy   User     @relation("ReassignedBy", fields: [reassignedById], references: [id])
  createdAt      DateTime @default(now())

  @@index([clientId])
  @@map("client_assignments")
}

model AuditLog {
  id        String   @id @default(uuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId    String?
  field     String
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())

  @@index([clientId])
  @@map("audit_logs")
}

model ApiKey {
  id         String    @id @default(uuid())
  name       String
  keyHash    String    @unique
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  // Si se define, esta llave solo puede leer/escribir clientes de este proyecto
  // (endpoints bajo /integrations/*). Null = llave global (comportamiento legacy).
  projectId  String?
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@map("api_keys")
}

// Dedupe de webhooks entrantes: cada integración manda un identificador de evento
// propio (call.id de ZyraVoice, deliveryId de RECOGIDA-PAQ). Antes de procesar, se
// intenta insertar una fila con esa clave; si ya existe (P2002), el evento es un
// reintento y se responde 200 sin volver a crear interacciones/auditoría duplicadas.
model WebhookEvent {
  id         String   @id @default(uuid())
  source     String
  externalId String
  createdAt  DateTime @default(now())

  @@unique([source, externalId])
  @@map("webhook_events")
}

model Company {
  id        String   @id @default(uuid())
  name      String
  industry  String?
  phone     String?
  website   String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clients Client[]
  deals   Deal[]

  @@index([name])
  @@map("companies")
}

model Deal {
  id                String    @id @default(uuid())
  title             String
  clientId          String?
  client            Client?   @relation(fields: [clientId], references: [id])
  companyId         String?
  company           Company?  @relation(fields: [companyId], references: [id])
  amount            Float?
  stage             DealStage @default(PROSPECTING)
  ownerId           String?
  owner             User?     @relation(fields: [ownerId], references: [id])
  expectedCloseDate DateTime?
  closedAt          DateTime?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([stage])
  @@index([ownerId])
  @@index([clientId])
  @@index([companyId])
  @@map("deals")
}

model Project {
  id                 String   @id @default(uuid())
  name               String
  description        String?
  repoUrl            String?
  archived           Boolean  @default(false)
  // organization_id que manda ZyraVoice en sus webhooks (calls, emails). Permite
  // que una sola integración de ZyraVoice sirva a varias empresas/proyectos sin
  // mezclarlas: /integrations/emails busca el Project por este campo antes de
  // matchear el cliente. Null = este proyecto no recibe webhooks de ZyraVoice.
  zyraOrganizationId String?  @unique
  // Estatus ocultos del Tablero/Tabla de Clientes de este proyecto — preferencia
  // compartida por todo el equipo (no borra ni desactiva el estatus, sigue
  // disponible en Admin y en el selector de Estatus de cada cliente).
  hiddenStatusIds    String[] @default([])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  members  ProjectMember[]
  sections ProjectSection[]
  tasks    ProjectTask[]
  clients  Client[]
  apiKeys  ApiKey[]
  lists    ClientList[]

  @@index([name])
  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model ProjectSection {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  tasks ProjectTask[]

  @@index([projectId])
  @@map("project_sections")
}

model ProjectTask {
  id         String         @id @default(uuid())
  projectId  String
  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sectionId  String
  section    ProjectSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  title      String
  status     TaskStatus     @default(PENDING)
  priority   TaskPriority   @default(MEDIUM)
  assigneeId String?
  assignee   User?          @relation(fields: [assigneeId], references: [id])
  dueDate    DateTime?
  notes      String?
  order      Int            @default(0)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([projectId])
  @@index([sectionId])
  @@index([assigneeId])
  @@map("project_tasks")
}
