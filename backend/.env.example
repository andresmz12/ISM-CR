DATABASE_URL=postgresql://user:password@localhost:5432/ism_crm
PORT=4000
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173
API_KEY_SALT=change_this_too
# Offset de la zona horaria del negocio en minutos respecto a UTC
# (Costa Rica = UTC-6 = -360). Define cuándo empieza "hoy" para las tareas.
TZ_OFFSET_MINUTES=-360
# Usuario al que se atribuyen las interacciones creadas por integraciones externas
SYSTEM_USER_EMAIL=sistema@ism.local
