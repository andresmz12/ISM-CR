DATABASE_URL=postgresql://user:password@localhost:5432/ism_crm
PORT=4000
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173
API_KEY_SALT=change_this_too
# Zona horaria del negocio (IANA). Define cuándo empieza "hoy" para las
# tareas/seguimientos y maneja el horario de verano automáticamente.
BUSINESS_TIMEZONE=America/Chicago
# Usuario al que se atribuyen las interacciones creadas por integraciones externas
SYSTEM_USER_EMAIL=sistema@ism.local
# SLA de primer contacto (horas) y umbral de cliente "frío" (días) para las alertas
SLA_FIRST_CONTACT_HOURS=24
SLA_STALE_DAYS=7
# Webhook de RECOGIDA-PAQ (POST /api/integrations/pickup-requests)
WEBHOOK_SECRET=change_this_to_a_long_random_secret
RECOGIDA_PAQ_API_URL=https://api.recogida-paq.example.com
RECOGIDA_PAQ_API_KEY=change_this_to_the_partner_api_key
# Webhook de ZyraVoice (POST /api/integrations/calls)
ZYRA_CRM_WEBHOOK_SECRET=change_this_to_a_long_random_secret
